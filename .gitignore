# Applies to every problem folder. problem-2/.gitignore adds the Next.js specifics.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# testing
coverage/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# local Claude Code config (dev-server launch settings)
.claude/
